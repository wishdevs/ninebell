# 더존 옴니솔 대시보드 백엔드 환경변수 예시
# 복사: cp .env.example .env

# PostgreSQL (async). 프로덕션은 운영 DSN 으로 교체.
DATABASE_URL=postgresql+asyncpg://dashboard:dashboard@localhost:5432/dashboard

# 세션 JWT(HS256) 서명키 — 반드시 교체.
AUTH_SECRET=dev-insecure-change-me-please
SESSION_TTL_HOURS=12

# 더존 옴니솔 ERP
ERP_BASE=https://erp.ninebell.co.kr
MAX_CONCURRENT_ERP_LOGINS=3

# LLM 프로바이더: gemini(기본 — GitHub/AWS 배포) | etribe(온프렘 — 사내 Etribe-LLM, 데이터 사외 반출 없음)
LLM_PROVIDER=gemini
# 온프렘 ETRIBE LLM(OpenAI 호환) 서버 주소·모델명 — LLM_PROVIDER=etribe 일 때만 사용.
# 2026-07-23 최종 확정: GLM-5.2 서버(모델 id ETRIBE-LLM — /v1/models 실측, 대문자).
# base 에 /v1 을 붙이지 않는다(클라이언트가 /v1/chat/completions 를 붙임).
ETRIBE_BASE_URL=http://172.20.50.2:30001
ETRIBE_MODEL=ETRIBE-LLM
# ETRIBE 서버 멀티모달 여부 — GLM-5.2 는 텍스트 전용(이미지 400)이라 false.
# 멀티모달 서버(192.168.50.2:8030 ETRIBE-VLM)로 전환 시 true.
ETRIBE_MULTIMODAL=false

# 최초 로그인 시 super_admin 으로 승격할 옴니솔 userid 목록(쉼표 구분).
SUPER_ADMIN_OMNISOL_IDS=

# 쿠키: 로컬 http=false, 프로덕션 https=true
COOKIE_SECURE=false

# CORS 허용 오리진(쉼표 구분). 프론트 dev 포트 3101.
CORS_ORIGINS=http://localhost:3101

# 개발용: 1 이면 startup 에서 Base.metadata.create_all 로 테이블 생성(Alembic 대체).
DEV_CREATE_ALL=0

# e2e 프로브(헤드리스 실화면 진단) 로그인 자격증명 — 로컬 .env 에만 채운다.
# ⚠ 커밋 금지: 값은 .env(gitignore 대상)에 두고 이 템플릿에는 키만 남긴다.
E2E_USERID=
E2E_PASSWORD=

# --- 로깅 ---
# root 로거 레벨(INFO 기본). 운영에서 조용히 하려면 WARNING.
LOG_LEVEL=INFO
# 로그 파일 경로(회전 50MB×5). 비우면 stdout 만 — 배포는 비워 둔다(ECS=CloudWatch,
# 온프렘=Docker json-file 이 stdout 을 수집하므로 컨테이너 안 파일은 무의미).
# 로컬 개발은 터미널을 닫아도 남도록 파일을 쓴다.
LOG_FILE=logs/app.log
# LLM 호출별 파일 로그 디렉터리(호출 1건 = 파일 1개, 요청 URL·바디·응답 전문).
# 비우면 끔(배포 기본값). 파일명 예: 20260729-092518_generateCo_12.log
LLM_LOG_DIR=logs/llm
