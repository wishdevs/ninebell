#!/usr/bin/env bash
# main 푸시 전 릴리스 등록 게이트.
#
# main 푸시 = AWS(ECS) + 온프렘 동시 배포다. 사용자에게 보이는 변경이 섞여 있는데
# 릴리스 노트가 없으면 여기서 막는다. 훅은 '판단'을 하지 않는다 — 커밋 타입만 보고
# "등록이 필요해 보인다"까지만 알리고, 분류·버전 결정·본문 작성은 Claude Code 가 한다.
#
# 활성화:  git config core.hooksPath .githooks
# 우회:    SKIP_RELEASE_CHECK=1 git push       (핫픽스·되돌리기 등)

set -euo pipefail

[ "${SKIP_RELEASE_CHECK:-}" = "1" ] && exit 0

remote_ref_is_main=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main | refs/heads/master) remote_ref_is_main=1 ;;
  esac
done
[ "$remote_ref_is_main" -eq 1 ] || exit 0

# 기준점: 마지막 릴리스 태그(vX.Y.Z). 태그가 아직 없으면(백필 직후) 릴리스 파일의
# 마지막 releasedAt 날짜를 기준으로 삼는다 — 그래야 부트스트랩이 전체 히스토리를 토해내지 않는다.
last_tag=$(git describe --tags --abbrev=0 --match 'v[0-9]*' 2>/dev/null || echo "")
releases_dir="$(git rev-parse --show-toplevel)/backend/app/data/releases"

if [ -n "$last_tag" ]; then
  base_desc="$last_tag"
  set -- "$last_tag..HEAD"
else
  last_date=$(grep -h '^releasedAt:' "$releases_dir"/*.md 2>/dev/null \
    | awk '{print $2}' | sort | tail -1)
  if [ -n "$last_date" ]; then
    base_desc="릴리스 $last_date"
    set -- --since="$last_date 23:59:59" HEAD
  else
    base_desc="(기준점 없음)"
    set -- HEAD
  fi
fi

# 사용자 비체감 타입은 제외 — docs/CHANGELOG-ENTRY.md '노트에서 제외할 것' 과 같은 목록.
user_facing=$(git log --no-merges --pretty=%s "$@" \
  | grep -Ev '^(ci|chore|style|test|docs|refactor|revert)(\([^)]*\))?!?:' \
  | grep -Ev '^(Merge|merge)' || true)

[ -z "$user_facing" ] && exit 0

count=$(printf '%s\n' "$user_facing" | wc -l | tr -d ' ')
cat >&2 <<EOF

┌─ 릴리스 노트가 필요합니다 ────────────────────────────────
│ ${base_desc} 이후 사용자에게 보이는 커밋 ${count}건이 아직 릴리스로 묶이지 않았습니다.
│
$(printf '%s\n' "$user_facing" | head -10 | sed 's/^/│   · /')
$([ "$count" -gt 10 ] && echo "│   … 외 $((count - 10))건")
│
│ Claude Code 에게 "릴리스 끊자" 라고 하세요.
│ 분류 → 버전 결정 → 본문 작성 → app/data/releases/ 커밋 → 태그까지 처리합니다.
│
│ 이번만 넘기려면:  SKIP_RELEASE_CHECK=1 git push
└───────────────────────────────────────────────────────────

EOF
exit 1
